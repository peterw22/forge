# Operating system files
.DS_Store

# Local Pi Go runtime state and session transcripts
/.pi-go/

# Locally built Go command binaries
/pi-go-agent
/pi-go-codex
/pi-go-tui

# Packaged release artifacts
/dist/

# Flutter/Dart generated files and build products
/flutter/pi_go_app/.dart_tool/
/flutter/pi_go_app/.flutter-plugins-dependencies
/flutter/pi_go_app/.pub/
/flutter/pi_go_app/build/
/flutter/pi_go_app/coverage/
/flutter/pi_go_app/android/.gradle/
/flutter/pi_go_app/android/.cxx/
/flutter/pi_go_app/android/build/
/flutter/pi_go_app/android/local.properties
/flutter/pi_go_app/macos/Flutter/ephemeral/
/flutter/pi_go_app/macos/Pods/

# IDE and editor workspace files
.idea/
*.iml
*.ipr
*.iws
*.swp

# Logs and temporary files
*.log
*.tmp
/flutter/pi_go_app/android/app/google-services.json
firebase-service-account*.json

# Local Apple provisioning profiles (device UDIDs and signing metadata)
/profile/
*.mobileprovision
*.provisionprofile
# Flatpak staging output
/flatpak/payload/
/build/flatpak-linux/
# Generated Apple build trees and published package artifacts
/flutter/pi_go_app/ios/build/
/flutter/pi_go_app/macos/build/
/s3/ios/*.ipa

